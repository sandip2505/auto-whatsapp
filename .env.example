# Server Configuration
PORT=5000
HOST=127.0.0.1
NODE_ENV=development

# Allowed Client Origin (CORS)
CLIENT_URL=http://localhost:5173

# Database & Storage
DATABASE_PATH=./data/scheduler.db
WHATSAPP_SESSION_PATH=./data/whatsapp_session

# Timezone & Localization Defaults
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY_CODE=+91

# Missed Job Policy on Startup: 'skip' (recommended) or 'manual_retry'
MISSED_JOB_POLICY=skip

# Retry Configuration for Failed Messages
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=60000

# WhatsApp Integration
# Set to 'true' to enable Mock mode for testing without requiring a live WhatsApp phone scan
WHATSAPP_MOCK=false

# Optional custom Chromium / Chrome path on Windows (uncomment if needed)
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
PUPPETEER_HEADLESS=true
