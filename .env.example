# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Allowed Client Origin (CORS)
# Leave blank or set to your Render URL (e.g. https://whatsapp-scheduler.onrender.com)
CLIENT_URL=

# Storage Directory
# When attaching a persistent disk on Render Starter, set DATA_DIR=/var/data or /app/data
# DATA_DIR=./data
DATABASE_PATH=./data/scheduler.db
WHATSAPP_SESSION_PATH=./data/whatsapp_session

# Timezone & Localization Defaults
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY_CODE=+91

# Missed Job Policy on Startup: 'skip' (recommended) or 'manual_retry'
MISSED_JOB_POLICY=skip

# Retry Configuration for Failed Messages
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=60000

# WhatsApp Integration
# Set to 'true' to enable Mock mode for testing without requiring a live WhatsApp phone scan
WHATSAPP_MOCK=false

# Headless Puppeteer browser settings
PUPPETEER_HEADLESS=true
# Optional custom Chromium / Chrome path (automatically detected in Docker/Linux)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Keep-Alive Settings for Render (Prevents Free Tier Sleep When Browser Tab Is Closed)
KEEP_ALIVE=true
KEEP_ALIVE_INTERVAL_MINUTES=10
# KEEP_ALIVE_URL=https://your-service.onrender.com
